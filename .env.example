# ETHIO ONE - fakkeenya qindaa'ina naannoo; secrets dhugaa as hin kaa'in.
# .env.example gara .env copy godhi; .env GitHub irratti hin olkaa'in.

# API / PostgreSQL (amma ijaarsi jiru Neon PostgreSQL + Node.js/Express fayyadama)
NODE_ENV=development
PORT=3000
DATABASE_URL=
JWT_SECRET=
SESSION_SECRET=

# Cloudinary - kuusaa miidiyaa amma jiru
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Cloudflare R2 - filannoo gara fuulduraa; hanga adapter qophaa'utti hin hojjetu
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=

# Supabase - filannoo gara fuulduraa qofa; database amma jiru bakka hin bu'u
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Firebase - filannoo gara fuulduraa qofa; amma hin qindeessine
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Kaffaltii / SMS - yeroo integration dhugaan qophaa'utti qindeessi
PAYO_ENABLED=false
PAYO_API_KEY=
SMSHUB_API_KEY=
